# ============================================================
# HYDRASCOUT — Environment Configuration
# Copy this file to .env.local and fill in what you have.
# EVERYTHING IS OPTIONAL: with no keys at all the app runs in
# full demo mode (in-memory data + simulated outreach).
# ============================================================

# ---------- Supabase (persistent database; recommended) ----------
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy variable names (still honored as fallbacks)
NEXT_PUBLIC_DATABASE_URL=
NEXT_PUBLIC_DATABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_SERVICE_ROLE_KEY=

# ---------- Outreach providers (optional; simulated when blank) ----------
# Email via Sender.net (primary — checked first if set)
SENDER_API_TOKEN=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=

# Email via SendGrid (used if Sender.net isn't configured)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Email via Mailgun (used automatically if neither Sender.net nor SendGrid is configured)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# SMS/voice via Twilio (requires consent/lawful basis — see README compliance notes)
# TWILIO_FROM_NUMBER must be in E.164 format, e.g. +16175551234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TwiML URL Twilio should play for outbound voice/voicemail drops (optional)
TWILIO_VOICEMAIL_TWIML_URL=

# Skip-trace / data quality (optional; used for contact enrichment)
MELISSA_API_KEY=

# ---------- AI features (optional; heuristic fallback when blank) ----------
# Tried in order: OpenAI → Anthropic → Gemini → OpenRouter → NVIDIA NIM → OpenCode Zen
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
NVIDIA_NIM_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
OPENCODE_ZEN_KEY=
OPENCODE_ZEN_MODEL=big-pickle

# ---------- External workflow engine (optional) ----------
# n8n / Make.com webhook that returns { records: RawRecord[] } for real
# county scraping workflows. Called during the Collect stage of every run.
N8N_WEBHOOK_URL=

# ---------- Outbound CRM / spreadsheet sync (optional) ----------
# After every completed campaign, Hydrascout POSTs the lead list + stats to
# whichever of these are set. Point a Zapier "Catch Hook" or Make "Webhooks"
# trigger here to fan the data out to Airtable, Google Sheets, Notion,
# HubSpot, GoHighLevel, or Salesforce without any code changes — or point
# directly at a native inbound webhook URL from one of those platforms.
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
N8N_CRM_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# ---------- Branding used in outreach templates & public pages ----------
COMPANY_NAME=Hydrascout Home Solutions
COMPANY_PHONE=
COMPANY_WEBSITE=
NEXT_PUBLIC_COMPANY_NAME=Hydrascout
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=

# Public URL this app is deployed at (used for Stripe redirects, templates, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3050

# ---------- Payments (optional; billing page runs in demo mode when blank) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Misc ----------
# Google Maps for the map view (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Force in-memory demo mode even if Supabase is configured
HYDRASCOUT_FORCE_DEMO=
